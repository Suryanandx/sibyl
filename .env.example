# ── OpenRouter (recommended): one key for chat, speech-to-text, and text-to-speech ──
# With OPENROUTER_API_KEY set and OPENAI_BASE_URL unset, the Gateway uses OpenRouter.
OPENROUTER_API_KEY=sk-or-your-key
LLM_PROVIDER=openrouter
# Model catalog the browser can choose from. Defaults to models.config.json, then
# models.config.example.json, in the project root.
# MODELS_CONFIG_FILE=models.config.json
# Fill TTS voice lists from OpenRouter's model catalog at startup.
MODELS_DISCOVER_VOICES=true
# OpenUI generative UI (charts, tables, cards, forms next to the spoken reply).
GENUI_ENABLED=true
# Live conversation: an audio-native "voice brain" hears your voice (tone, emotion)
# and talks back; it hands careful work and visuals to the "deep brain" (llm models).
# Needs a "voice" model list in models.config.json (or VOICE_MODELS).
LIVE_CONVERSATION=true
# Model scout: pick models from the live OpenRouter catalog by cost, Design Arena
# benchmarks and measured latency (default with OpenRouter). "manual" uses only
# models.config.json. Strategy sets the defaults: cheapest | balanced | fastest | best.
MODEL_SELECTION=auto
MODEL_STRATEGY=balanced
# Live latency probes (a few tiny paid requests, cached for 24 h in SCOUT_CACHE_FILE).
SCOUT_PROBE=true
SCOUT_CACHE_FILE=.model-scout.json
# Hedged requests: if the voice brain hasn't started after 1.2 s, also ask the
# fastest voice model from another vendor; if TTS hasn't produced audio after
# 1.5 s, send a duplicate request. First answer wins, the other is cancelled.
HEDGE_REQUESTS=true
HEDGE_VOICE_AFTER_MS=1200
HEDGE_TTS_AFTER_MS=1500
ASSISTANT_NAME=Sibyl
VOICE_MODELS=
# Instant on-device captions while you speak (browser speech recognition; in Chrome
# this is processed by the browser vendor). Set false to disable.
NEXT_PUBLIC_LIVE_CAPTIONS=true
# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Sibyl
# Without models.config.json, comma-separated lists ("id" or "id|Label") build the catalog:
LLM_MODELS=
STT_MODELS=
TTS_MODELS=

# ── OpenAI or another OpenAI-compatible provider (used when LLM_PROVIDER=openai) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=
STT_REALTIME_ENABLED=false
STT_REALTIME_URL=wss://api.openai.com/v1/realtime
STT_REALTIME_MODEL=gpt-realtime-whisper
STT_REALTIME_LANGUAGE=
STT_REALTIME_DELAY=low
TTS_ENABLED=true
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_FORMAT=mp3
GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8787
NEXT_PUBLIC_VAD_ADAPTIVE_ENABLED=true
NEXT_PUBLIC_VAD_CALIBRATION_MS=1000
NEXT_PUBLIC_VAD_NOISE_FLOOR_SMOOTHING=0.08
NEXT_PUBLIC_VAD_SPEECH_NOISE_MULTIPLIER=3
NEXT_PUBLIC_VAD_SILENCE_NOISE_MULTIPLIER=1.8
NEXT_PUBLIC_VAD_DYNAMIC_SPEECH_MIN=0.012
NEXT_PUBLIC_VAD_DYNAMIC_SPEECH_MAX=0.12
NEXT_PUBLIC_VAD_DYNAMIC_SILENCE_MIN=0.006
NEXT_PUBLIC_VAD_DYNAMIC_SILENCE_MAX=0.08
NEXT_PUBLIC_VAD_SPEECH_THRESHOLD=0.02
NEXT_PUBLIC_VAD_SILENCE_THRESHOLD=0.012
NEXT_PUBLIC_VAD_START_DEBOUNCE_MS=160
NEXT_PUBLIC_VAD_MIN_SPEECH_MS=200
NEXT_PUBLIC_VAD_HANGOVER_MS=400
NEXT_PUBLIC_VAD_MAX_TURN_MS=30000
NEXT_PUBLIC_VAD_PRE_ROLL_MS=400
NEXT_PUBLIC_VAD_PLAYBACK_THRESHOLD_MULTIPLIER=2.5
NEXT_PUBLIC_VAD_PLAYBACK_SUPPRESS_AFTER_END_MS=300

# Budgets (USD, all optional). Every model call is metered; with a cap set,
# Sibyl switches to the Cheapest preset at 85% and pauses calls at the cap.
# Days and months follow the gateway's local time zone.
# SIBYL_BUDGET_DAILY_USD=2
# SIBYL_BUDGET_MONTHLY_USD=20
# SIBYL_BUDGET_ROUTINE_RUN_USD=0.25
# SIBYL_BUDGET_ROUTINE_DAILY_USD=1

# --- Tools & MCP ---
# Built-in tools: web_search (OpenRouter web plugin, ~$0.01/search, needs OPENROUTER_API_KEY),
# read_webpage, weather, currency_convert, world_time, calculate, wikipedia. Set false to turn all off.
SIBYL_BUILTIN_TOOLS=true
# Model that digests web results for web_search (default: the OpenRouter default flash model).
SIBYL_WEB_SEARCH_MODEL=
# MCP servers: path to mcp.config.json (default: repo root / cwd). See mcp.config.example.json.
SIBYL_MCP_CONFIG=
SIBYL_MCP_CONNECT_TIMEOUT_MS=20000
SIBYL_MCP_CALL_TIMEOUT_MS=120000

# --- Sibyl Slides ---
# Slides engine (vendored Presenton) the gateway talks to. When unset, the gateway
# uses http://localhost:8000 only if it answers at startup. SIBYL_SLIDES=false turns slides off.
SIBYL_SLIDES_URL=
# SIBYL_SLIDES=false
# Model the engine generates decks with (for cost estimates; default: the OpenRouter default flash model).
SIBYL_SLIDES_MODEL=
# Fallback estimate per slide when the model's pricing is unknown (USD).
# SIBYL_SLIDES_USD_PER_SLIDE=0.004
# How long one deck may take to generate (ms).
# SIBYL_SLIDES_TIMEOUT_MS=600000
# Where the web app serves the engine's editor (Next rewrite).
# SIBYL_SLIDES_EDITOR_BASE=/slides
# Gateway HTTP origin for the Slides page (default: derived from NEXT_PUBLIC_GATEWAY_WS_URL).
# NEXT_PUBLIC_GATEWAY_HTTP_URL=http://localhost:8787

# Connections screen: allow adding local (stdio) MCP servers from the web app.
# A stdio server runs a command on this host with the gateway's permissions, so
# this is off by default; remote (HTTP) servers can always be added in the app.
SIBYL_ALLOW_STDIO_MCP=false

# --- Memory & uploads ---
# Memory across chats (remember / forget / recall tools + Settings → Memory). Set false to turn it off.
SIBYL_MEMORY=true
# Uploads (POST /api/uploads) are stored in $SIBYL_DATA_DIR/uploads. Max size per file in MB.
SIBYL_UPLOAD_MAX_MB=20
# Model used for messages with images when the chat model can't see images
# (default: the first vision-capable model in the catalog).
SIBYL_VISION_MODEL=

# --- Routines & inbox ---
# Scheduled routines (created by asking in chat). false turns the scheduler off.
SIBYL_ROUTINES=true
# Deep-brain model for routine runs (default: the session default LLM model).
SIBYL_ROUTINE_MODEL=
# Fallback time zone for new routines until a browser reports its own (default: TZ / server zone).
SIBYL_TIMEZONE=
# Per-run cost cap: each routine's own cap, else SIBYL_BUDGET_ROUTINE_RUN_USD, else $0.25 for new routines.

# --- Secrets ---
# API keys the user stores for integrations (request_secret, api_request, MCP configs via ${secret:NAME})
# are encrypted with AES-256-GCM. Master key: 32 random bytes, base64 (`openssl rand -base64 32`).
# When unset, one is generated once into $SIBYL_DATA_DIR/secret.key (mode 0600) — back that file up:
# without it, stored secrets cannot be decrypted. With SIBYL_STORAGE=memory the key is ephemeral.
# SIBYL_SECRET_KEY=

# --- Slides (Sibyl Slides, apps/slides) ---
# Deck engine for the gateway (FastAPI). Dev: http://localhost:8000; compose: http://slides:8000.
SIBYL_SLIDES_URL=http://localhost:8000
# Slide editor web app that this origin proxies at /slides (baked in at web build time).
SIBYL_SLIDES_WEB_URL=http://localhost:3100
# Public URL of the Sibyl app; the editor links back here when opened directly.
SIBYL_APP_URL=http://localhost:3000
# Deck model on OpenRouter (uses OPENROUTER_API_KEY). Any id from openrouter.ai/models.
SIBYL_SLIDES_MODEL=deepseek/deepseek-v4.1-flash
# Image generation is off unless set (slides get neutral placeholders + icons). Options:
# pexels | pixabay (free stock, needs PEXELS_API_KEY / PIXABAY_API_KEY), gpt-image-2 | gpt-image-1.5
# (OPENAI_API_KEY), gemini_flash | nanobanana_pro (GOOGLE_API_KEY), comfyui | open_webui |
# openai_compatible (self-hosted; see apps/slides/API.md).
SIBYL_SLIDES_IMAGE_PROVIDER=
# Where decks, exports and the engine database live (default apps/slides/data; /app_data in Docker).
# APP_DATA_DIRECTORY=

# --- Sibyl Enterprise (see LICENSING.md) ---
# Licence key (sibyl1.…), verified offline at startup. Unset: open source edition.
# Can also be pasted in Settings → Licence (stored in the data dir); this variable wins.
# SIBYL_LICENSE_KEY=
# Gateway build: oss | enterprise (default: include ee/ when the directory exists).
# SIBYL_EDITION=

# --- Accounts, invitations and workspaces (v0.4) ---
# On first start the web app asks for an owner account (email + password) at /setup.
# Until then Sibyl runs as before for a single person. SIBYL_OWNER_TOKEN, when set, is required
# to create that account and keeps working afterwards as an owner-level API key (?token= / Bearer).
# SIBYL_OWNER_TOKEN=
# Email: sign-in links and codes, invitations, notifications (otherwise admins copy the invite link).
# Amazon SES (eu-central-1), with IAM SMTP credentials, URL-encoded (docs/configuration.md#email):
#   smtp://SMTP_USER:SMTP_PASSWORD@email-smtp.eu-central-1.amazonaws.com:587?requireTLS=true
# SIBYL_SMTP_URL=
# SIBYL_SMTP_FROM=Sibyl <no-reply@opensibyl.world>
# Where the logo in emails is loaded from (default https://opensibyl.world/assets/).
# SIBYL_EMAIL_ASSET_BASE_URL=
# Invite links point at SIBYL_APP_URL (above) unless the request comes from an ALLOWED_ORIGINS page.

# --- Monitors (v0.4, see docs/monitors.md) ---
# Watch sources and notify or start a task when something matters. Checks run on the routine
# scheduler (they keep running with SIBYL_ROUTINES=false). Set to false to turn monitors off.
# SIBYL_MONITORS=true
# Small model for plain-language conditions (default: the Cheapest preset, else the routine model).
# SIBYL_MONITOR_MODEL=
# Email for monitors created with the owner token or in single-owner mode (signed-in people use their account email).
# SIBYL_MONITOR_EMAIL=

# --- Knowledge bases (v0.4) ---
# Keyword search (SQLite FTS5) works with no settings. Set an embeddings model to add semantic
# re-ranking (hybrid = keyword + cosine). Uses the LLM provider key; calls are metered.
# SIBYL_EMBEDDINGS_MODEL=openai/text-embedding-3-small
# SIBYL_EMBEDDINGS_BASE_URL=        # default: the LLM base URL (OpenRouter supports /embeddings)
# SIBYL_EMBEDDINGS_USD_PER_MTOK=0.02 # estimate when the provider reports no cost

# --- Integrations: Google, Microsoft (+ HubSpot, Salesforce in Enterprise) — docs/integrations.md ---
# Admins paste each vendor's OAuth client ID/secret in Integrations (stored in the secrets vault).
# Public gateway URL for the OAuth redirect URI (<url>/api/connectors/oauth/callback); default: from the request.
# SIBYL_PUBLIC_GATEWAY_URL=https://sibyl.example.com
# Optional: app credentials from the environment instead of the UI (the vault wins when both are set).
# SIBYL_GOOGLE_CLIENT_ID=
# SIBYL_GOOGLE_CLIENT_SECRET=
# SIBYL_MICROSOFT_CLIENT_ID=
# SIBYL_MICROSOFT_CLIENT_SECRET=
# SIBYL_MICROSOFT_TENANT=common
# SIBYL_CONNECTORS=false   # turn native connectors off

# Sign-in with Google / Microsoft (hosted sign-up; self-hosted sign-in for invited people).
# Separate from the connector apps above. See docs/hosting.md#sign-up.
# SIBYL_SIGNIN_GOOGLE_CLIENT_ID=
# SIBYL_SIGNIN_GOOGLE_CLIENT_SECRET=
# SIBYL_SIGNIN_MICROSOFT_CLIENT_ID=
# SIBYL_SIGNIN_MICROSOFT_CLIENT_SECRET=
# SIBYL_SIGNIN_MICROSOFT_TENANT=common
