FROM node:22-alpine AS build

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/gateway/package.json apps/gateway/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/adapters/package.json packages/adapters/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/genui/package.json packages/genui/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/store/package.json packages/store/package.json
RUN pnpm install --frozen-lockfile

COPY apps/gateway apps/gateway
COPY packages/adapters packages/adapters
COPY packages/protocol packages/protocol
COPY packages/genui packages/genui
COPY packages/core packages/core
COPY packages/store packages/store
RUN pnpm --filter @open-gpt-live/gateway build

FROM node:22-alpine AS runtime

WORKDIR /app
# Conversations and settings live in SQLite (Node's built-in node:sqlite,
# no flag needed on Node >= 22.13). Mount a volume at /app/data to keep them.
ENV NODE_ENV=production \
    GATEWAY_HOST=0.0.0.0 \
    GATEWAY_PORT=8787 \
    SIBYL_DATA_DIR=/app/data

COPY --from=build /app/apps/gateway/dist ./dist
# Default model catalog; override by mounting your own at /app/models.config.json
# or pointing MODELS_CONFIG_FILE elsewhere.
COPY models.config.example.json ./models.config.json

RUN mkdir -p /app/data && chown node:node /app/data
VOLUME ["/app/data"]

USER node
EXPOSE 8787
CMD ["node", "dist/server.cjs"]
